# bump: zosinfo-version /ZOSINFO_VERSION="(.*)"/ https://github.com/Johnparke888/zOSInfo.git|semver:*
ZOSINFO_VERSION="1.0.3"

###
### Build control file for the zOSInfo port
###
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/Johnparke888/zOSInfo/archive/refs/tags/${ZOSINFO_VERSION}.tar.gz"
export ZOPEN_STABLE_DEPS="make check_clang"
export ZOPEN_CATEGORIES="development library"
export ZOPEN_RUNTIME_DEPS="none"
# zOSInfo has no ./configure script (plain Makefile), so skip the configure phase.
export ZOPEN_CONFIGURE=skip
export ZOPEN_MAKE=skip

export ZOPEN_INSTALL="make"
export ZOPEN_INSTALL_OPTS="install --directory=zOSInfo DESTDIR=\$ZOPEN_INSTALL_DIR --always-make"
export ZOPEN_SYSTEM_PREREQ="zos24" # optional system pre-req (default=zos24)

export ZOPEN_CHECK="make"
export ZOPEN_CHECK_OPTS="--directory=zOSInfo --file=Makefile-Test check"

###
### Required user-supplied functions
###
zopen_check_results()
{
    chk="$1/$2_check.log"
    if grep -q "Error retrieving z/OS information" "$chk"; then
        failures=1
    else
        failures=0
    fi
    echo "actualFailures:${failures}"
    echo "totalTests:1"
    echo "expectedFailures:0"
    echo "expectedTotalTests:1"
}

zopen_get_version() 
{
    hdr="zOSInfo/include/zosinfo-version.h"

    major=$(grep '^#define ZOSINFO_VERSION_MAJOR' "$hdr" | awk '{print $3}')
    minor=$(grep '^#define ZOSINFO_VERSION_MINOR' "$hdr" | awk '{print $3}')
    patch=$(grep '^#define ZOSINFO_VERSION_PATCH' "$hdr" | awk '{print $3}')

    echo "${major}.${minor}.${patch}"
}

###
### Custom Build Logic (if applicable)
# If this port is a LIBRARY other ports will link against, uncomment this so
# dependent ports automatically get your headers and lib on their flags.
# Adjust the -I/-L paths and -l name to match what your Makefile installs.

zopen_append_to_env() 
{
cat <<END
  if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
   export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\${PWD}/include"
   export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\${PWD}/include"
   export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\${PWD}/lib"
   export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lzosinfo"
  fi
END

}
